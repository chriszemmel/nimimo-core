# ─── Required ─────────────────────────────────────────────────────────

# PostgreSQL (Neon) - used for all database operations
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# NextAuth - session management & OAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth - login provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend - magic link email delivery (SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Upstash Redis - rate limiting + balance/profile caching
# Supports both naming conventions (Vercel KV or direct Upstash)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=https://xxxx.upstash.io    # alternative (Vercel KV integration)
# KV_REST_API_TOKEN=                          # alternative (Vercel KV integration)

# Cloudflare R2 - avatar image storage (S3-compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nimimo
R2_PUBLIC_URL=https://pub-<bucket-id>.r2.dev

# ─── Optional ────────────────────────────────────────────────────────

# Alchemy - higher-quality RPC for ETH/SOL (falls back to public RPCs)
ALCHEMY_API_KEY=

# Etherscan - ETH transaction history (falls back without it)
ETHERSCAN_API_KEY=

# Email sender address (defaults to "nimimo <auth@nimimo.com>")
EMAIL_FROM=

# Site protection password - if set, requires password to access the app
PROTECTION_PASSWORD=

# ─── Telegram Bot (optional) ─────────────────────────────────────────

# Telegram Bot - contact form messages sent via Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ADMIN=
